{
  "name": "marpora-web",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "wasm": "cargo build -p marpora-md --features wasm --target wasm32-unknown-unknown --release && wasm-bindgen ../target/wasm32-unknown-unknown/release/marpora_md.wasm --target web --out-dir src/md/pkg",
    "predev": "pnpm wasm",
    "dev": "vite",
    "prebuild": "pnpm wasm",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs",
    "tauri": "cd .. && tauri"
  },
  "dependencies": {
    "@marp-team/marp-core": "4.4.0",
    "@mathjax/mathjax-newcm-font": "4.1.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "codemirror": "5.65.20",
    "dompurify": "3.4.17",
    "flowchart.js": "1.18.1",
    "lodash": "4.18.1",
    "mathjax": "4.1.0",
    "mermaid": "11.13.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8",
    "raphael": "2.3.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
