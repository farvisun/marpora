{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marpora",
  "identifier": "app.marpora.editor",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A fast Markdown editor",
    "copyright": "© 2026 Mohammad Askari. MIT License.",
    "homepage": "https://farvisun.github.io/marpora/",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdown", "mkd"], "name": "Markdown Document", "role": "Editor", "mimeType": "text/markdown" }
    ],
    "createUpdaterArtifacts": true,
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2MjU0ODQzQjM2OTExMUIKUldRYkVXbXpRMGdsbGhvOE5Ec3VNYUZQcFVWZGgxYm5OeE1DNjVQNjYvb1FaZUFiK1FSWENtSUUK",
      "endpoints": ["https://github.com/farvisun/marpora/releases/latest/download/latest.json"]
    }
  }
}
